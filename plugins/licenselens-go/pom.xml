<?xml version="1.0" encoding="UTF-8"?>
<!--
  这个插件是独立 reactor，不属于 parent pom 的 modules。
  理由：扩展要能单独构建、单独发布、核心源码不改。
  编译期依赖树验证：pom 里只允许出现 licenselens-spi，不能出现 licenselens-core。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.course</groupId>
    <artifactId>licenselens-go</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LicenseLens Go Plugin</name>
    <description>独立扩展：解析 go.mod → List&lt;Dependency&gt;</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <!-- 先安装 parent 与 spi 到本地仓库：在 parent 根目录执行 mvn -N install && mvn -pl licenselens-spi install -DskipTests -->
    <dependencies>
        <dependency>
            <groupId>edu.course</groupId>
            <artifactId>licenselens-spi</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
